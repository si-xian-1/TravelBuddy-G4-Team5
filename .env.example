# Google Gemini GenAI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Sabre API Credentials
SABRE_CLIENT_ID=your_sabre_client_id
SABRE_CLIENT_SECRET=your_sabre_client_secret

# MapBox API Key
MAPBOX_API_KEY=your_mapbox_api_key

# MySQL Database Credentials
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Disaster Data Mock Mode:
# true  -> loads mock disaster scenarios from classpath:demo_disasters.json
# false -> fetches live active disaster events from GDACS API
TRAVELBUDDY_MOCK_MODE=true

# Docker Hub Username (used to pull/push the application image)
DOCKERHUB_USERNAME=your_dockerhub_username